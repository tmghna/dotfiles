configuration {
    /* FIXED: The new array syntax required by recent Rofi versions */
    modi: "combi,drun,window";
    combi-modes: [ window, drun ];
    
    show-icons: true;
    icon-theme: "Papirus";
    display-combi: " ";
    
    combi-hide-mode-prefix: true;
    window-format: "  {w}  {c}";
    drun-display-format: "{name}";
    
    font: "JetBrainsMono Nerd Font 11";
}

* {
    bg: #1e1e2ee6;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #cba6f7;
    
    background-color: transparent;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    transparency: "real";
    width: 800px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 8px;
    padding: 20px;
}

mainbox {
    spacing: 20px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 12px 20px;
    spacing: 15px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 14";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search Apps or Windows...";
    placeholder-color: #a6adc8;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 15px;
    fixed-height: true;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 15px 10px;
    border-radius: 6px;
    spacing: 10px;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @accent;
    text-color: @accent;
}

element-icon {
    size: 48px;
    cursor: inherit;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 10";
    /* Simplified highlight to prevent parser crashes */
    highlight: bold italic;
}
